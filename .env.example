PORT=3000
DATA_DIR=./data
# Required on Vercel. Use a pooled Postgres URL with TLS from your database provider.
# Leave empty for local SQLite; DATA_DIR is ignored when DATABASE_URL is set.
DATABASE_URL=
# Generate distinct secrets with npm run setup; never commit .env.
DIAL_MCP_TOKEN=
CAMERA_TOKEN=
# Backend only. Use a paid Gemini project; requests set store=false.
# Leave empty to keep camera transport running without inference.
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite
# One consented demo caller, in E.164 format, e.g. +14155550123.
DEMO_CALLER_NUMBER=
# 4-8 digit PIN the caller must also say. Caller ID is spoofable: set this before connecting Google.
CALLER_PIN=
# Seeds synthetic memories. Use false when checking real camera evidence.
DEMO_MODE=true
# Laptop uploader only: set this to the Vercel project's public HTTPS origin.
# This is not a Vercel service binding. Omit to use the local PORT.
# BACKEND_URL=https://recall-kappa-nine.vercel.app

# IANA zone for "today" and calendar dates. Defaults to the Google calendar's zone, then UTC.
TIMEZONE=

# Dial (https://getdial.ai). Header names are unconfirmed; set DIAL_LOG_HEADERS=true on the
# first real call to log what arrives (values redacted), then adjust if needed.
DIAL_CALLER_HEADER=x-dial-user-number
DIAL_DIRECTION_HEADER=x-dial-direction
DIAL_LOG_HEADERS=false
# Signing secret shown when creating the webhook in the Dial dashboard (POST /webhooks/dial).
# Configure CRON_SECRET too so transcript retention runs even without incoming webhooks.
DIAL_WEBHOOK_SECRET=
DIAL_EVENT_RETENTION_DAYS=30
# Steph's Dial line (default +12408962183): reminder calls and texts come from it.
# STEPH_NUMBER=+12408962183
# Dial REST key (sk_live_...). Empty turns phone reminders off; run npm run db:init before setting it.
DIAL_API_KEY=
# Testing safety net: comma-separated E.164 numbers. When set, Dial never calls or texts anyone else.
DIAL_ALLOWED_NUMBERS=
# Caregiver for DEMO_CALLER_NUMBER (E.164): notify_caregiver alerts and the daily summary text go here.
CAREGIVER_NUMBER=
# More patients, as JSON: [{"number":"+1...","name":"Rosa","caregiver":"+1...","timeZone":"America/Chicago"}].
# Each caller only ever sees their own records; records without a patient belong to DEMO_CALLER_NUMBER.
PATIENTS=

# Google Calendar + Gmail (read-only). Leave GOOGLE_CLIENT_ID empty to disable.
# OAuth client type: Web application. Authorized redirect URI must equal GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback
# Protects /google/* admin routes; npm run setup generates these.
ADMIN_TOKEN=
# Encrypts the stored refresh token (64 hex characters).
GOOGLE_TOKEN_KEY=
# Vercel Cron sends this as a bearer token to /cron/google-sync, /cron/dial-reminders and /cron/caregiver-summary.
CRON_SECRET=
GOOGLE_CALENDAR_IDS=primary
GOOGLE_SYNC_MINUTES=10
GOOGLE_LIVE_TIMEOUT_MS=1500
GMAIL_SYNC_QUERY=newer_than:30d -category:promotions -category:social
GMAIL_SYNC_LIMIT=100
# Local same-URL Google mock such as a Sparta World. Loopback hosts only; refused on Vercel.
GOOGLE_API_BASE_URL=
GOOGLE_OAUTH_BASE_URL=

# Keewano product analytics (https://keewano.com). Empty disables it.
KEEWANO_API_KEY=
KEEWANO_ENDPOINT=
# Only on a server with a persistent disk; unset keeps unsent batches in memory (Vercel).
KEEWANO_DATA_DIR=

# Steph iOS app. Leave the token empty to keep /embed, /ask and /reminders off (503).
# Demo restriction: this shared secret ships inside the app binary. At least 32 characters, distinct from the tokens above.
RECALL_APP_TOKEN=
# Backend only. Steph's model: auto uses Claude when ANTHROPIC_API_KEY is set, else Gemini with GEMINI_API_KEY
# (the vision key above). With neither, /ask and /reminders return 503 and the app answers on device.
STEPH_PROVIDER=auto
ANTHROPIC_API_KEY=
STEPH_MODEL=claude-opus-5-5
STEPH_GEMINI_MODEL=gemini-3.5-flash-lite
# Backend only. Voyage AI embeddings for /embed; empty returns 503 and the app embeds on device.
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5-lite
