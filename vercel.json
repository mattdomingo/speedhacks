{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "recall": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "recall"
      }
    }
  ],
  "crons": [
    {
      "path": "/cron/google-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/cron/dial-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/cron/caregiver-summary",
      "schedule": "0 2 * * *"
    }
  ]
}
